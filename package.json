{
  "name": "@lobehub/charts",
  "version": "6.0.0",
  "description": "React modern charts components built on recharts",
  "keywords": [
    "lobehub",
    "charts"
  ],
  "homepage": "https://github.com/lobehub/lobe-charts",
  "bugs": {
    "url": "https://github.com/lobehub/lobe-charts/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-charts.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./es/index.d.mts",
      "import": "./es/index.mjs",
      "default": "./es/index.mjs"
    },
    "./es/utils": "./es/utils/index.mjs",
    "./es/*/ArrowRightIcon": "./es/*/ArrowRightIcon.mjs",
    "./es/*/BaseAnimationTimingProps": "./es/*/BaseAnimationTimingProps.mjs",
    "./es/*/BaseChartProps": "./es/*/BaseChartProps.mjs",
    "./es/*/BaseSparkChartProps": "./es/*/BaseSparkChartProps.mjs",
    "./es/*/Calendar": "./es/*/Calendar.mjs",
    "./es/*/CategoryBar": "./es/*/CategoryBar.mjs",
    "./es/*/ChartLabels": "./es/*/ChartLabels.mjs",
    "./es/*/ChartLegend": "./es/*/ChartLegend.mjs",
    "./es/*/ChartTooltipFrame": "./es/*/ChartTooltipFrame.mjs",
    "./es/*/ChartTooltipRow": "./es/*/ChartTooltipRow.mjs",
    "./es/*/CustomTooltipProps": "./es/*/CustomTooltipProps.mjs",
    "./es/*/CustomYAxisTick": "./es/*/CustomYAxisTick.mjs",
    "./es/*/DeltaBar": "./es/*/DeltaBar.mjs",
    "./es/*/DonutChartTooltip": "./es/*/DonutChartTooltip.mjs",
    "./es/*/Footer": "./es/*/Footer.mjs",
    "./es/*/LegendItem": "./es/*/LegendItem.mjs",
    "./es/*/MarkerBar": "./es/*/MarkerBar.mjs",
    "./es/*/NoData": "./es/*/NoData.mjs",
    "./es/*/ProgressBar": "./es/*/ProgressBar.mjs",
    "./es/*/ScatterChartTooltip": "./es/*/ScatterChartTooltip.mjs",
    "./es/*/ScatterChartTooltipRow": "./es/*/ScatterChartTooltipRow.mjs",
    "./es/*/ScrollButton": "./es/*/ScrollButton.mjs",
    "./es/*/SparkAreaChart": "./es/*/SparkAreaChart.mjs",
    "./es/*/SparkBarChart": "./es/*/SparkBarChart.mjs",
    "./es/*/SparkLineChart": "./es/*/SparkLineChart.mjs",
    "./es/*/TrackerBlock": "./es/*/TrackerBlock.mjs",
    "./es/*/calendar": "./es/*/calendar.mjs",
    "./es/*/charts": "./es/*/charts.mjs",
    "./es/*/getMaxLabelLength": "./es/*/getMaxLabelLength.mjs",
    "./es/*/inputParser": "./es/*/inputParser.mjs",
    "./es/*/renderInactiveShape": "./es/*/renderInactiveShape.mjs",
    "./es/*/renderShape": "./es/*/renderShape.mjs",
    "./es/*/styles": "./es/*/styles.mjs",
    "./es/*/theme": "./es/*/theme.mjs",
    "./es/*/types": "./es/*/types.mjs",
    "./es/*/useOnWindowResize": "./es/*/useOnWindowResize.mjs",
    "./es/*/usePrefersReducedMotion": "./es/*/usePrefersReducedMotion.mjs",
    "./es/*/useThemeColorRange": "./es/*/useThemeColorRange.mjs",
    "./es/*/utils": "./es/*/utils.mjs",
    "./es/*": "./es/*/index.mjs",
    "./es/*.js": {
      "types": "./es/*.d.mts",
      "import": "./es/*.mjs",
      "default": "./es/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "es/index.mjs",
  "module": "es/index.mjs",
  "types": "es/index.d.mts",
  "files": [
    "es"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "node scripts/generateExports.mjs",
    "build:watch": "tsdown --watch",
    "ci": "npm run lint && npm run type-check",
    "clean": "rm -r es lib dist coverage .react-router .eslintcache node_modules/.cache",
    "dev": "lobedocs dev",
    "docs:build": "lobedocs build",
    "docs:build-analyze": "ANALYZE=1 lobedocs build",
    "lint": "eslint \"{src,tests}/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:circular": "dpdm src/**/*.{ts,tsx}  --warning false  --tree false  --exit-code circular:1  -T true",
    "lint:md": "remark . --quiet --frail --output",
    "lint:style": "stylelint \"{src,tests}/**/*.{js,jsx,ts,tsx}\" --fix",
    "prepare": "husky && npm run setup",
    "prepublishOnly": "npm run build",
    "prettier": "prettier -c --write --no-error-on-unmatched-pattern \"**/**\"",
    "pull": "git pull",
    "release": "semantic-release",
    "setup": "lobedocs typegen",
    "start": "npm run dev",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage  --passWithNoTests",
    "test:update": "vitest -u",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.md": [
      "remark --quiet --output --",
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.json": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "stylelint --fix",
      "eslint --fix"
    ],
    "*.{ts,tsx}": [
      "prettier --parser=typescript --write",
      "stylelint --fix",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "ahooks": "^3.10.0",
    "chroma-js": "^3.2.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "fast-deep-equal": "^3.1.3",
    "lucide-react": "^0.562.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@icons-pack/react-simple-icons": "^9.7.0",
    "@lobehub/docs-kit": "^6.0.0",
    "@lobehub/fluent-emoji": "^5.0.0-beta.1",
    "@lobehub/icons": "^6.0.0-beta.1",
    "@lobehub/lint": "^1.26.3",
    "@lobehub/ui": "^6.0.0",
    "@react-router/dev": "8.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/chroma-js": "^3.1.2",
    "@types/pangu": "^4.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "~1.2.2",
    "commitlint": "^19.8.1",
    "cross-env": "^10.1.0",
    "dpdm": "^3.15.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "polished": "^4.3.1",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.2.0",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "semantic-release": "^21.1.2",
    "stylelint": "^15.11.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.1.4",
    "vitest": "~1.2.2"
  },
  "peerDependencies": {
    "@lobehub/ui": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
